CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for login. Choose your own credentials; there is no default account.
AUTH_USERNAME=
AUTH_PASSWORD=
# Required JWT signing secret, at least 32 random bytes. Never expose in frontend variables.
JWT_SECRET=
# Optional existing S3 bucket and its AWS region. Uses the standard AWS credential chain.
S3_BUCKET_NAME=
S3_REGION=
# Optional; not used by the placeholder workflow.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
META_MODEL_API_KEY=

# UTF-8 text object supplied as context for POST /api/v1/chat
S3_OBJECT_KEY=
S3_MAX_BYTES=200000

# Optional historical JSON snapshots; takes precedence over S3_OBJECT_KEY.
# Collector layout: snapshots/YYYY/MM/DD/YYYYMMDDTHHMMSSZ.json
# S3_SNAPSHOT_PREFIX=snapshots/
S3_HISTORY_DAYS=3
