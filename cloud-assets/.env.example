# Copy to .env, edit, then export before running Terraform:
# set -a; source .env; set +a
# Terraform does not automatically load .env files.

# Terraform input variables (match main.tf defaults).
TF_VAR_aws_region=us-east-1
TF_VAR_project_name=cloud-optimizer
TF_VAR_retention_days=14
# Optional existing backend IAM role allowed to assume the snapshot reader role.
TF_VAR_backend_role_arn=

# AWS CLI default region for manual collector invocation.
AWS_DEFAULT_REGION=us-east-1

# Optional named AWS profile. Otherwise use the standard AWS credential chain.
# AWS_PROFILE=your-profile
# Alternatively supply credentials locally; never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# TARGET_REGION and SNAPSHOT_BUCKET are set on the Lambda by Terraform.
